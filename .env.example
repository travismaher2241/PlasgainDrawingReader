# Copy to .env and fill in. Never commit .env.
GEMINI_API_KEY=
# Optional: which Gemini model reads the drawings (default gemini-3.1-pro-preview)
# GEMINI_MODEL=gemini-3.1-pro-preview
# Optional: shared passcode the team must enter to use the app
# APP_PASSCODE=
# Shared library in Firestore: either the whole service-account JSON on one line...
# FIREBASE_SERVICE_ACCOUNT=
# ...or these three
# FIREBASE_PROJECT_ID=
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_PRIVATE_KEY=
# FIRESTORE_PREFIX=takeoff
# Without Firebase, where the local Item List, aliases and correction log are stored
# DATA_DIR=./data
# PORT=8787
# HOST=127.0.0.1
